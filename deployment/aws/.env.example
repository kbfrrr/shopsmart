# Keep the real .env private. It is excluded from Git and Docker build contexts.
# Generate a fresh password on the ShopSmart server: openssl rand -hex 24
# Use the generated hex characters so the password is safe inside DATABASE_URL.
POSTGRES_PASSWORD=

# Recommended: shopsmart.<YOUR_ELASTIC_IP>.sslip.io (hostname only, no scheme).
SITE_ADDRESS=
# Must be the corresponding origin, for example https://shopsmart.<IP>.sslip.io
FRONTEND_URL=

# Set a unique tag per release, such as the short Git commit, before building.
SHOPSMART_IMAGE_TAG=local

# Leave blank for the catalog-only assistant. Never use a VITE_ secret.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
